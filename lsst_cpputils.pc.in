prefix=${pcfiledir}/../..
includedir=${prefix}/include
libdir=${prefix}/lib
doxygen_tag=${prefix}/doc/cpputils.tag
lsst_build_requires=boost_test pybind11

Name: lsst_cpputils
Description: LSST Science Pipelines C++ utilities
Version: @VERSION@
Requires: boost python3 lsst_pex_exceptions numpy
Cflags: -I${includedir}
Libs: -L${libdir} -lcpputils
